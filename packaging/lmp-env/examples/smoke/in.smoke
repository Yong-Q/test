# 64-water smoke run: 500 steps of NVT with MACELES-OFF (LES).
# Generated by sampling.les_c1c2.write_lammps_input, paths made relative to the bundle.
#
#   examples/smoke/run.sh
#   # or
#   . ./env.sh && lmp-run -k on g 1 -in examples/smoke/in.smoke -var home "$MACELES_HOME"

units metal
atom_style molecular/kk
atom_modify map yes
boundary p p p
package kokkos neigh half newton on
newton on
read_data ${home}/examples/smoke/H2O_64.lammps
pair_style symmetrix/mace/float32/kk no_domain_decomposition streamed_edges direct profile speed jit_device_artifact ${home}/assets/maceles_off/maceles_off.cubin jit_device_blocks_per_compute_unit 8
pair_coeff * * ${home}/assets/maceles_off/maceles_off_chno.json C H N O
neighbor 2.0 bin
neigh_modify every 10 delay 0 check yes
timestep 0.0005
velocity all create 300 12345 mom yes rot no dist gaussian
thermo 100
thermo_style custom step temp pe
run_style verlet/kk
fix 1 all nvt temp 300 300 0.1
run 40
unfix 1
fix 1 all nvt temp 300 300 0.1
run 160
reset_timestep 0
dump 1 all custom 100 traj.dump id mol type x y z fx fy fz
dump_modify 1 sort id
run 500
