#!/usr/bin/env bash
# Run the bundled LAMMPS binary with the bundled runtime libraries.
set -euo pipefail
_bin=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
BUNDLE=$(cd -- "$_bin/.." && pwd -P)
. "$BUNDLE/env.sh"
_missing=$(ldd "$BUNDLE/bin/lmp" | awk '/not found/{printf "%s ", $1}')
if [ -n "${_missing:-}" ]; then
    echo "lmp-run: missing shared libraries: $_missing" >&2
    echo "lmp-run: CUDA 12 toolkit (libcublas.so.12) is required; set CUDA_HOME or MACELES_CUDA_LIB" >&2
    exit 127
fi
exec "$BUNDLE/bin/lmp" "$@"
